#!/bin/bash
#PBS -N mmj_wk
#PBS -q small_gpuq
#PBS -l select=1:ncpus=4:ngpus=1:mem=24gb
#PBS -l walltime=08:00:00
#PBS -j oe
#
# Runs, one after another, the experiments listed in TASK_FILE.
# Each line:  NAME  MODEL  [--key=value ...]
# Submitted by scripts/submit_all.sh (which also sets the walltime for the whole list).
# Experiments whose log already has a final BEST block are skipped, so re-submitting after a
# walltime kill continues with what is left.

cd "$PBS_O_WORKDIR" || exit 1
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-Astar}"

DATASET="${DATASET:-baby}"
[ -f "$TASK_FILE" ] || { echo "Task file not found: $TASK_FILE"; exit 1; }

echo "Job ID:  $PBS_JOBID"
echo "Node:    $(hostname)"
echo "Python:  $(which python)"
echo "Tasks:   $TASK_FILE ($(grep -c . "$TASK_FILE") experiments)"
nvidia-smi

N_OK=0; N_FAIL=0; N_SKIP=0
while IFS= read -r LINE || [ -n "$LINE" ]; do
    LINE=$(echo "$LINE" | tr -d '\r')
    [ -z "$LINE" ] && continue
    NAME=$(echo "$LINE" | awk '{print $1}')
    MODEL=$(echo "$LINE" | awk '{print $2}')
    ARGS=$(echo "$LINE" | awk '{$1=""; $2=""; print}' | xargs)

    if grep -l 'BEST ████' src/log/"${MODEL}-${DATASET}-${NAME}"-*.log >/dev/null 2>&1; then
        echo "===== [skip] $NAME (finished log exists) ====="
        N_SKIP=$((N_SKIP + 1)); continue
    fi

    echo "===== [$(date '+%F %T')] start $NAME : $MODEL $ARGS ====="
    # shellcheck disable=SC2086
    if (cd src && python -u main.py -m "$MODEL" -d "$DATASET" --exp_name="$NAME" $ARGS < /dev/null); then
        N_OK=$((N_OK + 1)); echo "===== [$(date '+%F %T')] done  $NAME ====="
    else
        N_FAIL=$((N_FAIL + 1)); echo "===== [$(date '+%F %T')] FAILED $NAME (continuing) ====="
    fi
done < "$TASK_FILE"

echo "Worker finished: ok=$N_OK failed=$N_FAIL skipped=$N_SKIP"
