#!/bin/bash
#PBS -N e5_geom
#PBS -q small_gpuq
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#
# E5: main table + geometry (tools/geom_eval.py) from the taps of E3 and E4, per dataset.
#   qsub -v DS="baby dbbook" scripts/e5_geom.pbs
#   cat results/geom/baby/summary.md
cd "$PBS_O_WORKDIR" || exit 1
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-Astar}"
for D in ${DS:-baby dbbook}; do
  echo "===== $D $(date '+%F %T')"
  python -u tools/geom_eval.py -d "$D" || exit 1
done
echo "Done $(date '+%F %T')"
