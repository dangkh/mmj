#!/bin/bash
#PBS -N mmj_diag
#PBS -q small_gpuq
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=10:00:00
#PBS -j oe
#
# Diagnosis worker (submitted by scripts/submit_diag.sh). TASK_FILE lines:
#     NAME  MODEL  DATASET  SEED  [--key=value ...]
# For each task, PARALLEL at a time on the job's GPU:
#   1. train MODEL on DATASET with --save_taps=True (skipped if its log already has a final BEST block)
#   2. tools/probe_knn.py on the taps                (skipped if the json exists)
#   3. tools/graph_control.py on the taps, DRAGON only (skipped if the json exists)
# Console output of each task: <TASK_FILE dir>/<MODEL>-<DATASET>-<NAME>.out

cd "$PBS_O_WORKDIR" || exit 1
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-Astar}"

PARALLEL="${PARALLEL:-2}"
STAGGER="${STAGGER:-120}"
[ -f "$TASK_FILE" ] || { echo "Task file not found: $TASK_FILE"; exit 1; }
OUT_DIR="$(dirname "$TASK_FILE")"
export OMP_NUM_THREADS=$(( ${NCPUS:-4} / PARALLEL > 0 ? ${NCPUS:-4} / PARALLEL : 1 ))
echo "Job $PBS_JOBID on $(hostname): $(grep -c . "$TASK_FILE") tasks, $PARALLEL at a time"
nvidia-smi

run_task() {   # run_task NAME MODEL DATASET SEED ARGS...
    local NAME=$1 MODEL=$2 DS=$3 SEED=$4; shift 4
    local TAG="${MODEL}-${DS}-${NAME}" TAPS="taps/${MODEL}-${DS}-${NAME}" OUT="$OUT_DIR/${MODEL}-${DS}-${NAME}.out"
    echo "===== [$(date '+%F %T')] start $TAG (seed $SEED) $* ====="
    (
        TAPS_ARG="--save_taps=True"; case "$NAME" in *_grid) TAPS_ARG="" ;; esac
        if grep -l 'BEST ████' src/log/"${MODEL}-${DS}-${NAME}"-*.log >/dev/null 2>&1; then
            echo "[train] skip (finished log exists)"
        else
            # shellcheck disable=SC2068
            (cd src && python -u main.py -m "$MODEL" -d "$DS" --exp_name="$NAME" --seed="$SEED" $TAPS_ARG $@ < /dev/null) \
                || { echo "[train] FAILED"; exit 1; }
        fi
        case "$NAME" in *_grid) echo "[probe] tuning run: no probe"; exit 0 ;; esac
        if [ -f "log/probe_knn_${DS}_${MODEL}_${NAME}.json" ]; then
            echo "[probe] skip"
        else
            python -u tools/probe_knn.py -d "$DS" --taps "$TAPS" --no_raw --tag "${MODEL}_${NAME}" || echo "[probe] FAILED"
        fi
        if [ "$MODEL" = "DRAGON" ] || [ "$MODEL" = "DRAGONID" ] || [ "$MODEL" = "MENTOR" ]; then
            if [ -f "log/graph_control_${DS}_${MODEL}-${DS}-${NAME}.json" ]; then
                echo "[graph_control] skip"
            else
                python -u tools/graph_control.py -d "$DS" --taps "$TAPS" || echo "[graph_control] FAILED"
            fi
        fi
    ) > "$OUT" 2>&1
    local rc=$?
    echo "===== [$(date '+%F %T')] end   $TAG rc=$rc (see $OUT) ====="
    return $rc
}

N=0; FAIL=0
while IFS= read -r LINE || [ -n "$LINE" ]; do
    LINE=$(echo "$LINE" | tr -d '\r'); [ -z "$LINE" ] && continue
    # shellcheck disable=SC2086
    set -- $LINE
    while [ "$(jobs -rp | wc -l)" -ge "$PARALLEL" ]; do wait -n || FAIL=$((FAIL + 1)); done
    [ "$N" -gt 0 ] && sleep "$STAGGER"
    run_task "$@" &
    N=$((N + 1))
done < "$TASK_FILE"
while [ "$(jobs -rp | wc -l)" -gt 0 ]; do wait -n || FAIL=$((FAIL + 1)); done
echo "Worker finished: tasks=$N failed=$FAIL"
