#!/bin/bash
#PBS -N e4_jepa
#PBS -q med_gpuq
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l walltime=48:00:00
#PBS -j oe
#
# E4: LightGCNJEPA (src/models/lightgcnjepa.py) on one dataset, seed 999, rho in {3, 5, 10, 15}%:
#   (a) e4u     uniform mask x rho x lambda {0.01, 0.1, 1}                          (12 runs)
#   (b) e4h/e4t hub / tail mask x rho, lambda = best of (a)                          (8 runs)
#   (c) e4n     node mask x rho, lambda = best of (a)                                (4 runs)
#   (e) e4edge  edge target (other endpoint of a masked edge), uniform, rho of (a), lambda {0.01, 0.1, 1} (3 runs)
#   (d) e4vic   best of (a)-(e) + VICReg {0.1, 1}                                    (2 runs)
#   (f) e4best_s3  best of all, seeds 1 and 2                                         (2 runs)
# Same LightGCN backbone as E3. Finished runs are skipped. Taps: taps/LightGCNJEPA-<DS>-e4*/
#   qsub -v DS=baby scripts/e4_jepa.pbs
cd "$PBS_O_WORKDIR" || exit 1
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-Astar}"
[ -n "${DS:-}" ] || { echo "DS not set"; exit 1; }
echo "Job $PBS_JOBID on $(hostname), dataset $DS, $(date '+%F %T')"
source scripts/idssl_common.sh
M=LightGCNJEPA
R="[0.03,0.05,0.1,0.15]"
LW="[0.01,0.1,1]"
F="--target_type=agg --vic_weight=0 --seed=999"

# shellcheck disable=SC2086
run $M e4u $BB --mask_mode=uniform --mask_ratio="$R" --jepa_weight="$LW" $F
LAM=$(best $M e4u --key jepa_weight) || { echo "no result for e4u"; exit 1; }
RHO=$(best $M e4u --key mask_ratio)
echo "best of (a): jepa_weight $LAM, mask_ratio $RHO"
for MODE in hub tail node; do
  E=e4$(echo $MODE | cut -c1)
  # shellcheck disable=SC2086
  run $M $E $BB --mask_mode=$MODE --mask_ratio="$R" --jepa_weight="$LAM" $F
done
# shellcheck disable=SC2086
run $M e4edge $BB --mask_mode=uniform --mask_ratio="$RHO" --jepa_weight="$LW" --target_type=edge --vic_weight=0 --seed=999
P=$(best $M e4u e4h e4t e4n e4edge)
echo "best of (a)-(e): $P"
# shellcheck disable=SC2086
run $M e4vic $BB $P --vic_weight="[0.1,1]" --seed=999
seeds $M e4best_s3 e4u e4h e4t e4n e4edge e4vic
echo "Done $(date '+%F %T')"
