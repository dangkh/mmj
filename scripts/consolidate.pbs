#!/bin/bash
#PBS -N consolidate
#PBS -q small_gpuq
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l walltime=24:00:00
#PBS -j oe
#
# Text -> ID consolidation (B0-B3) for one dataset (tools/consolidate.py):
#   1. frozen teachers: LightGCNC item_input=id and item_input=text, best setting of the teacher study
#      (logs <src>_grid), seed 999, with --save_taps=True  -> taps/LightGCNC-<ds>-teacher_{id,text}
#   2. grid on valid for B2 and B3 with the first seed of SEEDS, then the remaining seeds of SEEDS for the
#      selected setting; summary.md. SEEDS defaults to "999" (one seed, check run); later: SEEDS="999 1 2"
# Finished steps are skipped.
#
#   qsub -v DS=dbbook scripts/consolidate.pbs
#   qsub -v DS=baby scripts/consolidate.pbs
#   qsub -v DS=dbbook,SEEDS="999 1 2" scripts/consolidate.pbs     # add seeds 1, 2 later (finished runs reused)

cd "$PBS_O_WORKDIR" || exit 1
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-Astar}"
[ -n "${DS:-}" ] || { echo "DS not set (qsub -v DS=dbbook ...)"; exit 1; }
echo "Job $PBS_JOBID on $(hostname), dataset $DS, $(date '+%F %T')"
nvidia-smi

for SRC in id text; do
    TAPS="taps/LightGCNC-${DS}-teacher_${SRC}"
    if [ -f "$TAPS/T3.npy" ] && [ -f "$TAPS/T3_user.npy" ]; then echo "[skip] $TAPS exists"; continue; fi
    P=$(python tools/best_params.py LightGCNC "$DS" "${SRC}_grid") || { echo "no finished ${SRC}_grid log for $DS"; exit 1; }
    echo "===== teacher $SRC: $P ====="
    # shellcheck disable=SC2086
    (cd src && python -u main.py -m LightGCNC -d "$DS" --item_input="$SRC" $P --seed=999 \
        --save_taps=True --exp_name="teacher_${SRC}") || exit 1
done

python -u tools/consolidate.py -d "$DS" --grid --seeds "${SEEDS:-999}" \
    --id_taps "taps/LightGCNC-${DS}-teacher_id" --text_taps "taps/LightGCNC-${DS}-teacher_text"
echo "Done $(date '+%F %T')"
